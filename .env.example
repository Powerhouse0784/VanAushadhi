# All variables below are OPTIONAL. GreenRoots runs fully offline out of the
# box (local seed data + a rule-based safety net) with none of these set.
# Copy this file to .env and fill in only what you want to enable.

# Supabase — enables real auth, persistence, and storage instead of the
# local AsyncStorage + seed-data fallback.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — enables real AI responses in the Plant & Health Assistant instead
# of the safe rule-based fallback responder.
EXPO_PUBLIC_GEMINI_API_KEY=
